# BridgeLab configuration. Copy to `.env` and adjust. Every knob below is read
# by `Settings.from_env()` and validated (positive int/float/port, non-empty
# host/model, valid effort enum, well-formed launch command). Defaults shown
# are the out-of-the-box values — the bridge runs unchanged with this file as-is.
# `.env` is gitignored; never commit real tokens.

# ── Registry ────────────────────────────────────────────────────────────────
# Path to the project authorization registry (relative paths resolve to cwd).
PROJECTS_CONFIG_PATH=projects.json

# ── Server ──────────────────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Self-managed candidate probe port (must differ from MCP_PORT).
CANDIDATE_MCP_PORT=8001
CANDIDATE_HEALTH_TIMEOUT_SECONDS=30
# Private root for detached worktrees + the `.state` SQLite DB. Must be OUTSIDE
# every configured project root.
JOB_WORKTREE_ROOT=~/.local/state/local-dev-mcp/worktrees
GIT_COMMAND_TIMEOUT_SECONDS=30

# ── Claude invocation ───────────────────────────────────────────────────────
# The underlying model Claude Code jobs use. Honored per-project when a project
# sets `claude_model`; otherwise this global value applies.
CLAUDE_MODEL=glm-5.2:cloud

# How the bridge starts the Claude Code drafter. Shell-split with shlex; the
# standalone `{model}` token is replaced with the resolved model (exact token
# equality — `prefix{model}` is rejected). Everything up to the operator-owned
# `--` passthrough is yours; the bridge appends the security tail
# (--permission-mode, --tools, --disallowedTools Bash/WebFetch/WebSearch/mcp__*,
# --strict-mcp-config, --disable-slash-commands, --max-turns, --output-format,
# --effort) after the prefix. To run `claude` directly instead of via
# `ollama launch`, set:  CLAUDE_LAUNCH_COMMAND=claude --model {model} -p
CLAUDE_LAUNCH_COMMAND=ollama launch claude --model {model} --yes -- -p

# Same, for the one-shot read-only reviewer. Defaults to the same prefix; set
# separately if your reviewer needs a different launcher.
CLAUDE_REVIEW_LAUNCH_COMMAND=ollama launch claude --model {model} --yes -- -p

# Global default effort when a tool call and the project both omit one.
# Per-call value > project `default_effort` > this global. `ultracode` is still
# rejected at job start for projects with `allow_ultracode=false` (fail-closed).
CLAUDE_DEFAULT_EFFORT=high

# ── Claude budget & continuity (MCPB-010) ───────────────────────────────────
CLAUDE_TIMEOUT_SECONDS=1800
# Default per-slice turn limit (a project `claude_max_turns` overrides).
CLAUDE_MAX_TURNS=30
# Soft warn at this cumulative turn count.
CLAUDE_SOFT_TURNS=30
# Turns granted per in-place extension slice.
CLAUDE_EXTENSION_TURNS=30
# Max in-place extensions before pausing the job.
CLAUDE_MAX_EXTENSIONS=3
# Absolute cumulative turn cap.
CLAUDE_HARD_TURNS=120
# Pause when the changed-path set is unchanged for this many turns.
CLAUDE_MAX_NO_PROGRESS_TURNS=6
# Terminate as failed_infrastructure above this many tool failures.
CLAUDE_MAX_TOOL_FAILURES=5
# Progress-sampler cadence (seconds; may be fractional).
CLAUDE_CHECKPOINT_INTERVAL_SECONDS=30
# Checkpoint count that triggers compaction.
CLAUDE_CHECKPOINT_MAX=500
# Drive Claude with --output-format stream-json --verbose for real turn/tool
# counts. Off => plain json (final envelope only; sampler-derived counts).
CLAUDE_STREAM_JSON=off

# ── Job I/O limits ──────────────────────────────────────────────────────────
MAX_INPUT_CHARS=100000
MAX_OUTPUT_BYTES=2097152
# Bounded sub-agent delegations per job (M-GV-06).
MAX_DELEGATIONS_PER_JOB=3

# ── Markdown reader / writer limits ─────────────────────────────────────────
MAX_MARKDOWN_FILE_BYTES=1048576
MAX_MARKDOWN_LIST_RESULTS=500
MAX_MARKDOWN_SEARCH_RESULTS=100
MAX_MARKDOWN_RANGE_LINES=1000
MAX_MARKDOWN_WRITE_BYTES=1048576
MAX_MARKDOWN_DIFF_BYTES=262144
# Opt-in prompt-injection defense: fence + delimit untrusted repository content
# the reader ingests so model directives cannot ride in file contents.
READER_INJECTION_DEFENSE=off

# ── Verification & commit (MCPB-005) ────────────────────────────────────────
VERIFICATION_COMMAND_TIMEOUT_SECONDS=600
MAX_VERIFICATION_OUTPUT_BYTES=1048576
VERIFICATION_DETERMINISTIC_REPETITIONS=1
MAX_COMMIT_MESSAGE_CHARS=500

# ── Host runtime verification (MCPB-011) ────────────────────────────────────
RUNTIME_VERIFICATION_COMMAND_TIMEOUT_SECONDS=1200
MAX_RUNTIME_VERIFICATION_OUTPUT_BYTES=1048576

# ── Working-tree candidate capture (MCPB-012) ───────────────────────────────
MAX_WORKING_TREE_CAPTURE_MANIFEST_PATHS=500
MAX_WORKING_TREE_CAPTURE_FILE_BYTES=10485760

# ── Tunnel (required only by tunnel.py) ─────────────────────────────────────
# Your ngrok authtoken — the only place it should ever live.
NGROK_AUTHTOKEN=replace_with_your_token
# Optional reserved ngrok domain for a stable connector URL. Leave blank for an
# ephemeral URL that changes every run.
NGROK_DOMAIN=your-reserved-domain.ngrok-free.dev
OPENAI_MTLS_CA_PATH=openai-connectors-mtls-ca.pem